import "std/io";

@noinline fn cmp_span(s: uint8*, a: int32, b: int32, n: int32) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (s[a + i] != s[b + i]) {
      return 0;
    }
    i += 1;
  }
  return 1;
}

@noinline fn sum_span(s: uint8*, off: int32, n: int32) -> int32 {
  var acc: int32 = 0;
  var i: int32 = 0;
  while (i < n) {
    acc = acc + (int32)s[off + i] * (i + 1);
    i += 1;
  }
  return acc;
}

@noinline fn copy_span(dst: uint8*, dpos: int32, src: uint8*, spos: int32,
                       n: int32) {
  var i: int32 = 0;
  while (i < n) {
    dst[dpos + i] = src[spos + i];
    i += 1;
  }
}

fn main() -> int32 {
  var buf: uint8[256];
  var out: uint8[256];
  var i: int32 = 0;
  while (i < 256) {
    buf[i] = (uint8)(i & 31);
    out[i] = 0;
    i += 1;
  }

  var fails: int32 = 0;

  if (cmp_span(&buf[0], 0, 32, 32) != 1) {
    println("FAIL cmp_span equal spans");
    fails += 1;
  }
  if (cmp_span(&buf[0], 0, 1, 32) != 0) {
    println("FAIL cmp_span unequal spans");
    fails += 1;
  }
  if (cmp_span(&buf[0], 5, 5, 0) != 1) {
    println("FAIL cmp_span zero length");
    fails += 1;
  }

  var want: int32 = 0;
  var k: int32 = 0;
  while (k < 16) {
    want = want + (int32)buf[8 + k] * (k + 1);
    k += 1;
  }
  var got: int32 = sum_span(&buf[0], 8, 16);
  if (got != want) {
    println("FAIL sum_span = {got} want {want}");
    fails += 1;
  }
  if (sum_span(&buf[0], 3, 0) != 0) {
    println("FAIL sum_span zero length");
    fails += 1;
  }

  copy_span(&out[0], 10, &buf[0], 40, 24);
  var j: int32 = 0;
  while (j < 24) {
    if (out[10 + j] != buf[40 + j]) {
      var a: int32 = (int32)out[10 + j];
      var b: int32 = (int32)buf[40 + j];
      println("FAIL copy_span at {j}: {a} want {b}");
      fails += 1;
      j = 24;
    }
    j += 1;
  }
  if (out[9] != 0 || out[34] != 0) {
    println("FAIL copy_span wrote outside its span");
    fails += 1;
  }

  if (fails == 0) {
    println("PASS");
    return 0;
  }
  println("{fails} case(s) failed");
  return 1;
}
