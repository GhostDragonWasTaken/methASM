import "std/io";

struct Row {
  w64: int64;
  u64: uint64;
  w32: int32;
  u32: uint32;
  pad: int64;
}

@noinline fn order64(a: int64, b: int64) -> int32 {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

@noinline fn order32(a: int32, b: int32) -> int32 {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

@noinline fn orderu64(a: uint64, b: uint64) -> int32 {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

@noinline fn orderu32(a: uint32, b: uint32) -> int32 {
  if (a < b) {
    return -1;
  }
  if (a > b) {
    return 1;
  }
  return 0;
}

fn field_order64(a: Row*, b: Row*) -> int32 {
  if (a->w64 < b->w64) {
    return -1;
  }
  if (a->w64 > b->w64) {
    return 1;
  }
  return 0;
}

fn field_orderu64(a: Row*, b: Row*) -> int32 {
  if (a->u64 < b->u64) {
    return -1;
  }
  if (a->u64 > b->u64) {
    return 1;
  }
  return 0;
}

fn field_order32(a: Row*, b: Row*) -> int32 {
  if (a->w32 < b->w32) {
    return -1;
  }
  if (a->w32 > b->w32) {
    return 1;
  }
  return 0;
}

fn field_orderu32(a: Row*, b: Row*) -> int32 {
  if (a->u32 < b->u32) {
    return -1;
  }
  if (a->u32 > b->u32) {
    return 1;
  }
  return 0;
}

fn field_eq64(a: Row*, b: Row*) -> int32 {
  if (a->w64 != b->w64) {
    return 0;
  }
  return 1;
}

fn indexed_order64(rows: Row*, i: int32, j: int32) -> int32 {
  if (rows[i].w64 < rows[j].w64) {
    return -1;
  }
  if (rows[i].w64 > rows[j].w64) {
    return 1;
  }
  return 0;
}

fn indexed_order32(rows: Row*, i: int32, j: int32) -> int32 {
  if (rows[i].w32 < rows[j].w32) {
    return -1;
  }
  if (rows[i].w32 > rows[j].w32) {
    return 1;
  }
  return 0;
}

fn scan_equal64(rows: Row*, n: int32, key: int64) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (rows[i].w64 == key) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn scan_below64(rows: Row*, n: int32, key: int64) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (rows[i].w64 < key) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn scan_above64(rows: Row*, n: int32, key: int64) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (rows[i].w64 > key) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn scan_belowu64(rows: Row*, n: int32, key: uint64) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (rows[i].u64 < key) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn scan_below_imm64(rows: Row*, n: int32) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (rows[i].w64 < -1000003) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn scan_above_imm64(rows: Row*, n: int32) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (rows[i].w64 > 65535) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn scan_equal_imm64(rows: Row*, n: int32) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    if (rows[i].w64 == 42) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

struct Node {
  next: int32;
  value: int32;
  visits: int32;
  pad: int32;
}

fn chase32(nodes: Node*, head: int32) -> int64 {
  var sum: int64 = 0;
  var idx: int32 = head;
  while (idx >= 0) {
    sum = sum + (int64)nodes[idx].value;
    nodes[idx].visits = nodes[idx].visits + 1;
    if (nodes[idx].visits > 3) {
      nodes[idx].next = -1;
    }
    idx = nodes[idx].next;
  }
  return sum;
}

fn chase64(links: int64*, values: int64*, visits: int64*, head: int64) -> int64 {
  var sum: int64 = 0;
  var idx: int64 = head;
  while (idx >= 0) {
    sum = sum + values[idx];
    visits[idx] = visits[idx] + 1;
    if (visits[idx] > 3) {
      links[idx] = -1;
    }
    idx = links[idx];
  }
  return sum;
}

@noinline fn chase_ref(next: int32*, value: int32*, head: int32,
                       limit: int32) -> int64 {
  var sum: int64 = 0;
  var idx: int32 = head;
  var steps: int32 = 0;
  while (steps < limit) {
    if (idx < 0) {
      return sum;
    }
    sum = sum + (int64)value[idx];
    idx = next[idx];
    steps = steps + 1;
  }
  return -1;
}

@noinline fn scan_ref(vals: int64*, n: int32, key: int64, mode: int32) -> int32 {
  var i: int32 = 0;
  while (i < n) {
    var v: int64 = vals[i];
    var hit: int32 = 0;
    if (mode == 0) {
      if (v == key) {
        hit = 1;
      }
    } else if (mode == 1) {
      if (v < key) {
        hit = 1;
      }
    } else if (mode == 2) {
      if (v > key) {
        hit = 1;
      }
    } else {
      var a: uint64 = (uint64)v;
      var b: uint64 = (uint64)key;
      if (a < b) {
        hit = 1;
      }
    }
    if (hit == 1) {
      return i;
    }
    i = i + 1;
  }
  return -1;
}

fn field_vs_value64(a: Row*, v: int64) -> int32 {
  if (a->w64 < v) {
    return -1;
  }
  if (a->w64 > v) {
    return 1;
  }
  return 0;
}

fn value_vs_field64(v: int64, a: Row*) -> int32 {
  if (v < a->w64) {
    return -1;
  }
  if (v > a->w64) {
    return 1;
  }
  return 0;
}

fn field_vs_valueu64(a: Row*, v: uint64) -> int32 {
  if (a->u64 < v) {
    return -1;
  }
  if (a->u64 > v) {
    return 1;
  }
  return 0;
}

fn imm_probe64(a: Row*) -> int32 {
  var acc: int32 = 0;
  if (a->w64 < 0) {
    acc = acc + 1;
  }
  if (a->w64 == 42) {
    acc = acc + 2;
  }
  if (a->w64 > 2147483647) {
    acc = acc + 4;
  }
  if (a->w64 != -1000003) {
    acc = acc + 8;
  }
  if (a->w64 <= -2147483648) {
    acc = acc + 16;
  }
  if (a->w64 >= 65535) {
    acc = acc + 32;
  }
  return acc;
}

fn imm_probe32(a: Row*) -> int32 {
  var acc: int32 = 0;
  if (a->w32 < 0) {
    acc = acc + 1;
  }
  if (a->w32 == 42) {
    acc = acc + 2;
  }
  if (a->w32 > 32767) {
    acc = acc + 4;
  }
  if (a->w32 != -1000003) {
    acc = acc + 8;
  }
  if (a->w32 <= -128) {
    acc = acc + 16;
  }
  if (a->w32 >= 255) {
    acc = acc + 32;
  }
  return acc;
}

fn immu_probe32(a: Row*) -> int32 {
  var acc: int32 = 0;
  if (a->u32 == 42) {
    acc = acc + 1;
  }
  if (a->u32 > 2147483647) {
    acc = acc + 2;
  }
  if (a->u32 < 65535) {
    acc = acc + 4;
  }
  return acc;
}

@noinline fn imm_ref64(v: int64) -> int32 {
  var acc: int32 = 0;
  var zero: int64 = 0;
  var a: int64 = 42;
  var b: int64 = 2147483647;
  var c: int64 = -1000003;
  var d: int64 = -2147483648;
  var e: int64 = 65535;
  if (v < zero) {
    acc = acc + 1;
  }
  if (v == a) {
    acc = acc + 2;
  }
  if (v > b) {
    acc = acc + 4;
  }
  if (v != c) {
    acc = acc + 8;
  }
  if (v <= d) {
    acc = acc + 16;
  }
  if (v >= e) {
    acc = acc + 32;
  }
  return acc;
}

@noinline fn imm_ref32(v: int32) -> int32 {
  var acc: int32 = 0;
  var zero: int32 = 0;
  var a: int32 = 42;
  var b: int32 = 32767;
  var c: int32 = -1000003;
  var d: int32 = -128;
  var e: int32 = 255;
  if (v < zero) {
    acc = acc + 1;
  }
  if (v == a) {
    acc = acc + 2;
  }
  if (v > b) {
    acc = acc + 4;
  }
  if (v != c) {
    acc = acc + 8;
  }
  if (v <= d) {
    acc = acc + 16;
  }
  if (v >= e) {
    acc = acc + 32;
  }
  return acc;
}

@noinline fn immu_ref32(v: uint32) -> int32 {
  var acc: int32 = 0;
  var a: uint32 = 42;
  var b: uint32 = 2147483647;
  var c: uint32 = 65535;
  if (v == a) {
    acc = acc + 1;
  }
  if (v > b) {
    acc = acc + 2;
  }
  if (v < c) {
    acc = acc + 4;
  }
  return acc;
}

fn main() -> int32 {
  var bad: int32 = 0;
  var n: int32 = 24;

  var vals: int64[24];
  vals[0] = 0;
  vals[1] = 1;
  vals[2] = -1;
  vals[3] = 2;
  vals[4] = -2;
  vals[5] = 127;
  vals[6] = -128;
  vals[7] = 128;
  vals[8] = 255;
  vals[9] = 256;
  vals[10] = 32767;
  vals[11] = -32768;
  vals[12] = 65535;
  vals[13] = 2147483647;
  vals[14] = -2147483648;
  vals[15] = 2147483648;
  vals[16] = 4294967295;
  vals[17] = 4294967296;
  vals[18] = -4294967296;
  vals[19] = 9223372036854775807;
  vals[20] = -9223372036854775807;
  vals[21] = 1000003;
  vals[22] = -1000003;
  vals[23] = 42;

  var rows: Row[24];
  var i: int32 = 0;
  while (i < n) {
    rows[i].w64 = vals[i];
    rows[i].u64 = (uint64)vals[i];
    rows[i].w32 = (int32)vals[i];
    rows[i].u32 = (uint32)vals[i];
    rows[i].pad = 0;
    i = i + 1;
  }

  i = 0;
  while (i < n) {
    var j: int32 = 0;
    while (j < n) {
      var got: int32 = field_order64(&rows[i], &rows[j]);
      var want: int32 = order64(rows[i].w64, rows[j].w64);
      if (got != want) {
        println("field64 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = indexed_order64(&rows[0], i, j);
      if (got != want) {
        println("indexed64 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = field_eq64(&rows[i], &rows[j]);
      var eq: int32 = 0;
      if (want == 0) {
        eq = 1;
      }
      if (got != eq) {
        println("eq64 i={i} j={j} got={got} want={eq}");
        bad = bad + 1;
      }

      got = field_orderu64(&rows[i], &rows[j]);
      want = orderu64(rows[i].u64, rows[j].u64);
      if (got != want) {
        println("fieldu64 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = field_order32(&rows[i], &rows[j]);
      want = order32(rows[i].w32, rows[j].w32);
      if (got != want) {
        println("field32 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = indexed_order32(&rows[0], i, j);
      if (got != want) {
        println("indexed32 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = field_orderu32(&rows[i], &rows[j]);
      want = orderu32(rows[i].u32, rows[j].u32);
      if (got != want) {
        println("fieldu32 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = field_vs_value64(&rows[i], vals[j]);
      want = order64(rows[i].w64, vals[j]);
      if (got != want) {
        println("fieldvsval64 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = value_vs_field64(vals[j], &rows[i]);
      want = order64(vals[j], rows[i].w64);
      if (got != want) {
        println("valvsfield64 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      got = field_vs_valueu64(&rows[i], (uint64)vals[j]);
      want = orderu64(rows[i].u64, (uint64)vals[j]);
      if (got != want) {
        println("fieldvsvalu64 i={i} j={j} got={got} want={want}");
        bad = bad + 1;
      }

      j = j + 1;
    }
    i = i + 1;
  }

  i = 0;
  while (i < n) {
    var key: int64 = vals[i];
    var gs: int32 = scan_equal64(&rows[0], n, key);
    var ws: int32 = scan_ref(&vals[0], n, key, 0);
    if (gs != ws) {
      println("scan_equal i={i} got={gs} want={ws}");
      bad = bad + 1;
    }
    gs = scan_below64(&rows[0], n, key);
    ws = scan_ref(&vals[0], n, key, 1);
    if (gs != ws) {
      println("scan_below i={i} got={gs} want={ws}");
      bad = bad + 1;
    }
    gs = scan_above64(&rows[0], n, key);
    ws = scan_ref(&vals[0], n, key, 2);
    if (gs != ws) {
      println("scan_above i={i} got={gs} want={ws}");
      bad = bad + 1;
    }
    gs = scan_belowu64(&rows[0], n, (uint64)key);
    ws = scan_ref(&vals[0], n, key, 3);
    if (gs != ws) {
      println("scan_belowu i={i} got={gs} want={ws}");
      bad = bad + 1;
    }
    i = i + 1;
  }

  {
    var gs: int32 = scan_below_imm64(&rows[0], n);
    var ws: int32 = scan_ref(&vals[0], n, -1000003, 1);
    if (gs != ws) {
      println("scan_below_imm got={gs} want={ws}");
      bad = bad + 1;
    }
    gs = scan_above_imm64(&rows[0], n);
    ws = scan_ref(&vals[0], n, 65535, 2);
    if (gs != ws) {
      println("scan_above_imm got={gs} want={ws}");
      bad = bad + 1;
    }
    gs = scan_equal_imm64(&rows[0], n);
    ws = scan_ref(&vals[0], n, 42, 0);
    if (gs != ws) {
      println("scan_equal_imm got={gs} want={ws}");
      bad = bad + 1;
    }
  }

  i = 0;
  while (i < n) {
    var gi: int32 = imm_probe64(&rows[i]);
    var wi: int32 = imm_ref64(rows[i].w64);
    if (gi != wi) {
      println("imm64 i={i} got={gi} want={wi}");
      bad = bad + 1;
    }
    gi = imm_probe32(&rows[i]);
    wi = imm_ref32(rows[i].w32);
    if (gi != wi) {
      println("imm32 i={i} got={gi} want={wi}");
      bad = bad + 1;
    }
    gi = immu_probe32(&rows[i]);
    wi = immu_ref32(rows[i].u32);
    if (gi != wi) {
      println("immu32 i={i} got={gi} want={wi}");
      bad = bad + 1;
    }
    i = i + 1;
  }

  {
    var chain: Node[24];
    var nx: int32[24];
    var vl: int32[24];
    var links: int64[24];
    var values: int64[24];
    var visits: int64[24];
    i = 0;
    while (i < n) {
      var nxt: int32 = i + 1;
      if (nxt >= n) {
        nxt = -1;
      }
      chain[i].next = nxt;
      chain[i].value = i * 3 + 1;
      chain[i].visits = 0;
      chain[i].pad = 0;
      nx[i] = nxt;
      vl[i] = i * 3 + 1;
      links[i] = (int64)nxt;
      values[i] = (int64)(i * 3 + 1);
      visits[i] = 0;
      i = i + 1;
    }
    var cg: int64 = chase32(&chain[0], 0);
    var cw: int64 = chase_ref(&nx[0], &vl[0], 0, n + 4);
    if (cg != cw) {
      println("chase32 got={cg} want={cw}");
      bad = bad + 1;
    }
    cg = chase64(&links[0], &values[0], &visits[0], 0);
    if (cg != cw) {
      println("chase64 got={cg} want={cw}");
      bad = bad + 1;
    }
  }

  if (bad != 0) {
    return 1;
  }
  println("FUSED LOAD COMPARE: ALL OK");
  return 0;
}
