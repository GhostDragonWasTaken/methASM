import "std/io";

struct Tab {
  src: uint8*;
  off: int32*;
  len: int32*;
  count: int32;
}

fn same_span(t: Tab*, i: int32, off: int32, len: int32) -> int32 {
  var k: int32 = 0;
  while (k < len) {
    if (t->src[t->off[i] + k] != t->src[off + k]) {
      return 0;
    }
    k = k + 1;
  }
  return 1;
}

fn sum_while_writing(a: int32*, n: int32) -> int64 {
  var total: int64 = 0;
  var k: int32 = 0;
  while (k < n) {
    total = total + (int64)a[0];
    a[0] = a[0] + 1;
    k = k + 1;
  }
  return total;
}

fn read_first_n_times(a: int32*, n: int32) -> int64 {
  var total: int64 = 0;
  var k: int32 = 0;
  while (k < n) {
    total = total + (int64)a[0];
    k = k + 1;
  }
  return total;
}

fn bump_and_sum(t: Tab*, i: int32, n: int32) -> int64 {
  var total: int64 = 0;
  var k: int32 = 0;
  while (k < n) {
    total = total + (int64)t->off[i];
    t->off[i] = t->off[i] + 1;
    k = k + 1;
  }
  return total;
}

fn nested_scan(t: Tab*, off: int32, len: int32) -> int32 {
  var i: int32 = 0;
  while (i < t->count) {
    if (t->len[i] == len) {
      if (same_span(t, i, off, len) != 0) {
        return i;
      }
    }
    i = i + 1;
  }
  return -1;
}

fn main() -> int32 {
  var fails: int32 = 0;

  var text: uint8[32];
  var offs: int32[4];
  var lens: int32[4];
  var i: int32 = 0;
  while (i < 32) {
    text[i] = (uint8)(97 + i % 4);
    i = i + 1;
  }
  text[0] = 100;
  text[1] = 111;
  text[2] = 103;
  text[8] = 99;
  text[9] = 97;
  text[10] = 116;
  text[16] = 100;
  text[17] = 111;
  text[18] = 103;

  offs[0] = 0;  lens[0] = 3;
  offs[1] = 8;  lens[1] = 3;
  offs[2] = 16; lens[2] = 3;
  offs[3] = 0;  lens[3] = 0;

  var t: Tab;
  t.src = &text[0];
  t.off = &offs[0];
  t.len = &lens[0];
  t.count = 4;

  if (nested_scan(&t, 16, 3) != 0) {
    var r: int32 = nested_scan(&t, 16, 3);
    println("FAIL nested_scan(dog) = {r} want 0");
    fails = fails + 1;
  }
  if (nested_scan(&t, 8, 3) != 1) {
    var r2: int32 = nested_scan(&t, 8, 3);
    println("FAIL nested_scan(cat) = {r2} want 1");
    fails = fails + 1;
  }
  if (nested_scan(&t, 4, 3) != -1) {
    var r3: int32 = nested_scan(&t, 4, 3);
    println("FAIL nested_scan(miss) = {r3} want -1");
    fails = fails + 1;
  }
  if (same_span(&t, 3, 12, 0) != 1) {
    println("FAIL same_span with len 0 did not return 1");
    fails = fails + 1;
  }

  var cell: int32[1];
  cell[0] = 5;
  var got: int64 = sum_while_writing(&cell[0], 4);
  if (got != 26) {
    println("FAIL sum_while_writing = {got} want 26");
    fails = fails + 1;
  }
  if (cell[0] != 9) {
    var c: int32 = cell[0];
    println("FAIL sum_while_writing left {c} want 9");
    fails = fails + 1;
  }

  offs[3] = 10;
  got = bump_and_sum(&t, 3, 4);
  if (got != 46) {
    println("FAIL bump_and_sum = {got} want 46");
    fails = fails + 1;
  }
  if (offs[3] != 14) {
    var o: int32 = offs[3];
    println("FAIL bump_and_sum left off[3] = {o} want 14");
    fails = fails + 1;
  }
  offs[3] = 0;
  if (bump_and_sum(&t, 3, 0) != 0) {
    println("FAIL bump_and_sum with n 0 returned nonzero");
    fails = fails + 1;
  }
  if (offs[3] != 0) {
    println("FAIL bump_and_sum with n 0 wrote to off[3]");
    fails = fails + 1;
  }

  cell[0] = 7;
  got = read_first_n_times(&cell[0], 5);
  if (got != 35) {
    println("FAIL read_first_n_times = {got} want 35");
    fails = fails + 1;
  }
  got = read_first_n_times(&cell[0], 0);
  if (got != 0) {
    println("FAIL read_first_n_times with n 0 = {got} want 0");
    fails = fails + 1;
  }

  if (fails == 0) {
    println("PASS");
    return 0;
  }
  println("{fails} case(s) failed");
  return 1;
}
