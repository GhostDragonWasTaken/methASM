import "std/io";
import "std/mem";

const N: int32 = 20000;
const SCALE: int64 = 1000003;
var table: int64[8];

@noinline fn transform(dst: int64*, src: int64*, n: int32, salt: int64) {
  var i: int32 = 0;
  @parallel while (i < n) {
    var v: int64 = src[i] ^ salt;
    var acc: int64 = 0;
    var k: int32 = 0;
    while (k < 24) {
      v = v * 6364136223846793005 + 1442695040888963407;
      if ((v & 1) == 1) {
        acc = acc ^ (v >> 11);
      } else {
        acc = acc + (v >> 7);
      }
      k += 1;
    }
    dst[i] = acc;
    i += 1;
  }
}

@noinline fn stripe(rows: int64*, width: int32, height: int32) {
  var y: int32 = 0;
  @parallel for (y = 0; y < height; y += 1) {
    var base: int32 = y * width;
    var x: int32 = 0;
    while (x < width) {
      rows[base + x] = (int64)(y * 31 + x) * 2654435761;
      x += 1;
    }
  }
}

fn shift_rows(out: int64*, src: int64*, width: int32, height: int32,
              gain: int64) {
  var row: int32 = 0;
  @parallel while (row < height) {
    var y: int32 = row * width;
    var x: int32 = 0;
    while (x < width) {
      out[y + x] = src[y + x] * gain + (int64)row;
      x += 1;
    }
    row += 1;
  }
}

fn scale(out: float64*, src: float64*, n: int32, gain: float64,
         bias: float64) {
  var i: int32 = 0;
  @parallel while (i < n) {
    out[i] = src[i] * gain + bias;
    i += 1;
  }
}

fn main() -> int32 {
  var a: int64* = (int64*)malloc(8 * (int64)N);
  var b: int64* = (int64*)malloc(8 * (int64)N);
  var i: int32 = 0;
  while (i < N) {
    a[i] = (int64)i * 1000003;
    i += 1;
  }

  transform(b, a, N, 987654321);
  var mixed: int64 = 0;
  i = 0;
  while (i < N) {
    mixed = mixed ^ (b[i] + (int64)i);
    i += 1;
  }

  var grid: int64* = (int64*)malloc(8 * 64 * 128);
  stripe(grid, 64, 128);
  var striped: int64 = 0;
  i = 0;
  while (i < 64 * 128) {
    striped = striped + grid[i];
    i += 1;
  }

  var wide: int64* = (int64*)malloc(8 * 4096);
  i = 0;
  while (i < 8) { table[i] = (int64)i * 7 - 3; i += 1; }
  i = 0;
  @parallel while (i < 4096) {
    wide[i] = (int64)i * SCALE + table[i & 7];
    i += 1;
  }
  var reused: int64 = (int64)i;
  i = 0;
  while (i < 4096) {
    reused = reused + wide[i];
    i += 1;
  }

  var lifted: int64* = (int64*)malloc(8 * 4096);
  shift_rows(lifted, wide, 64, 64, 5);
  var shifted: int64 = 0;
  i = 0;
  while (i < 4096) {
    shifted = shifted ^ lifted[i];
    i += 1;
  }

  var counted: int64* = (int64*)malloc(8 * 4096);
  @parallel for k in 0..4096 {
    counted[k] = (int64)k * SCALE - table[k & 7];
  }
  var ranged: int64 = 0;
  i = 0;
  while (i < 4096) {
    ranged = ranged ^ counted[i];
    i += 1;
  }

  var fa: float64* = (float64*)malloc(8 * 4096);
  var fb: float64* = (float64*)malloc(8 * 4096);
  i = 0;
  while (i < 4096) { fa[i] = (float64)i * 0.5; i += 1; }
  scale(fb, fa, 4096, 3.25, 1.5);
  var scaled: float64 = 0.0;
  i = 0;
  while (i < 4096) { scaled = scaled + fb[i]; i += 1; }

  println("mixed = {mixed}");
  println("striped = {striped}");
  if (mixed != 392376813670142450) {
    println("FAIL: the parallel while loop did not reproduce the serial answer");
    return 1;
  }
  if (striped != 43490275508224000) {
    println("FAIL: the parallel for loop did not reproduce the serial answer");
    return 1;
  }
  println("reused = {reused}");
  if (reused != 8386585251840) {
    println("FAIL: the counter or the globals did not survive the loop");
    return 1;
  }
  println("shifted = {shifted}");
  if (shifted != -228173824) {
    println("FAIL: the inlined marked loop did not reproduce the serial answer");
    return 1;
  }
  println("ranged = {ranged}");
  if (ranged != 100614144) {
    println("FAIL: the parallel range-for loop did not reproduce the serial answer");
    return 1;
  }
  println("scaled = {scaled}");
  if (scaled != 13634304.0) {
    println("FAIL: the float values did not survive the context");
    return 1;
  }
  println("ok");
  return 0;
}
