import "std/io";
import "std/bench";

fn fib(n: int32) -> int64 {
  if (n < 2) {
    return (int64)n;
  }
  return fib(n - 1) + fib(n - 2);
}

fn main() -> int32 {
  var passes: int32 = 5;
  println("Recursive fib(34) x 5 passes");

  var t0: int64 = bench_time_us();
  var acc: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    acc = acc + fib(34);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Checksum = ");
  println("{acc}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");
  return 0;
}
