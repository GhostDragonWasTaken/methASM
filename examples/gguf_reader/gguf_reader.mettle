import "std/io";
import "std/mem";

fn le_u32(b: uint8*) -> int64 {
  return (int64)b[0] | ((int64)b[1] << 8) | ((int64)b[2] << 16) | ((int64)b[3] << 24);
}
fn le_u64(b: uint8*) -> int64 {
  return le_u32(b) | (le_u32(&b[4]) << 32);
}

fn skip_bytes(fp: cstring, scr: uint8*, n: int64) {
  var left: int64 = n;
  while (left > 0) {
    var c: int64 = left;
    if (c > 64) { c = 64; }
    fread(scr, 1, c, fp);
    left = left - c;
  }
}

fn read_str(fp: cstring, lenbuf: uint8*, scr: uint8*, out: uint8*,
                  cap: int64) -> int64 {
  fread(lenbuf, 1, 8, fp);
  var len: int64 = le_u64(lenbuf);
  var take: int64 = len;
  if (take > cap - 1) { take = cap - 1; }
  fread(out, 1, take, fp);
  out[take] = 0;
  if (len - take > 0) { skip_bytes(fp, scr, len - take); }
  return len;
}

fn read_u32v(fp: cstring, b: uint8*) -> int64 {
  fread(b, 1, 4, fp);
  return le_u32(b);
}
fn read_u64v(fp: cstring, b: uint8*) -> int64 {
  fread(b, 1, 8, fp);
  return le_u64(b);
}

fn scalar_size(t: int64) -> int64 {
  if (t == 0 || t == 1 || t == 7) { return 1; }
  if (t == 2 || t == 3) { return 2; }
  if (t == 4 || t == 5 || t == 6) { return 4; }
  if (t == 10 || t == 11 || t == 12) { return 8; }
  return 0;
}
fn is_int_type(t: int64) -> int32 {
  if (t == 0 || t == 1 || t == 2 || t == 3 || t == 4 || t == 5 || t == 7 || t == 10 || t == 11) { return 1; }
  return 0;
}

fn print_ggml_type(t: int64) {
  if (t == 0) { print("F32"); return; }
  if (t == 1) { print("F16"); return; }
  if (t == 8) { print("Q8_0"); return; }
  if (t == 12) { print("Q4_K"); return; }
  if (t == 14) { print("Q6_K"); return; }
  if (t == 15) { print("Q8_K"); return; }
  print("type#"); print("{t}");
}

fn main() -> int32 {
  var path: cstring = "C:/Users/Marquis/.lmstudio/models/lmstudio-community/gemma-4-12B-it-GGUF/gemma-4-12B-it-Q4_K_M.gguf";
  var fp: cstring = fopen(path, "rb");
  if (fp == 0) {
    println("could not open file");
    return 1;
  }

  var b: uint8* = malloc(16);
  var scr: uint8* = malloc(128);
  var key: uint8* = malloc(128);
  var val: uint8* = malloc(256);

  fread(b, 1, 4, fp);
  if (b[0] != 71 || b[1] != 71 || b[2] != 85 || b[3] != 70) {
    println("not a GGUF file");
    fclose(fp);
    return 1;
  }
  var version: int64 = read_u32v(fp, b);
  var n_tensors: int64 = read_u64v(fp, b);
  var n_kv: int64 = read_u64v(fp, b);

  print("GGUF version "); print("{version}");
  print(",  "); print("{n_tensors}");
  print(" tensors,  "); print("{n_kv}");
  println(" metadata entries");
  println("------------------------------------------------------------");

  var i: int64 = 0;
  while (i < n_kv) {
    read_str(fp, b, scr, key, 128);
    var vtype: int64 = read_u32v(fp, b);

    print("  ");
    print_cstr((cstring)key);
    print(" = ");

    if (vtype == 8) {
      read_str(fp, b, scr, val, 256);
      println_cstr((cstring)val);
    } else if (vtype == 9) {
      var et: int64 = read_u32v(fp, b);
      var cnt: int64 = read_u64v(fp, b);
      print("[array of "); print("{cnt}");
      print(" x type#"); print("{et}"); println("]");
      if (et == 8) {
        var k: int64 = 0;
        while (k < cnt) {
          var sl: int64 = read_u64v(fp, b);
          skip_bytes(fp, scr, sl);
          k = k + 1;
        }
      } else {
        skip_bytes(fp, scr, cnt * scalar_size(et));
      }
    } else if (is_int_type(vtype) == 1) {
      var sz: int64 = scalar_size(vtype);
      fread(b, 1, sz, fp);
      var v: int64 = 0;
      if (sz == 8) { v = le_u64(b); }
      else if (sz == 4) { v = le_u32(b); }
      else if (sz == 2) { v = (int64)b[0] | ((int64)b[1] << 8); }
      else { v = (int64)b[0]; }
      println("{v}");
    } else {
      skip_bytes(fp, scr, scalar_size(vtype));
      println("(float)");
    }
    i = i + 1;
  }

  println("------------------------------------------------------------");
  println("tensors (first 12):");
  var hist: int64* = malloc(40 * 8);
  var z: int64 = 0;
  while (z < 40) { hist[z] = 0; z = z + 1; }

  var t: int64 = 0;
  while (t < n_tensors) {
    read_str(fp, b, scr, key, 128);
    var ndim: int64 = read_u32v(fp, b);
    var d0: int64 = 1; var d1: int64 = 1;
    var dd: int64 = 0;
    while (dd < ndim) {
      var dv: int64 = read_u64v(fp, b);
      if (dd == 0) { d0 = dv; }
      if (dd == 1) { d1 = dv; }
      dd = dd + 1;
    }
    var gt: int64 = read_u32v(fp, b);
    read_u64v(fp, b);
    if (gt >= 0 && gt < 40) { hist[gt] = hist[gt] + 1; }

    if (t < 12) {
      print("  ");
      print_cstr((cstring)key);
      print("  [");
      print("{d0}");
      if (ndim > 1) { print(" x "); print("{d1}"); }
      print("]  ");
      print_ggml_type(gt);
      println("");
    }
    t = t + 1;
  }

  println("------------------------------------------------------------");
  println("tensor dtype histogram:");
  var h: int64 = 0;
  while (h < 40) {
    if (hist[h] > 0) {
      print("  ");
      print_ggml_type(h);
      print(": ");
      println("{hist[h]}");
    }
    h = h + 1;
  }

  fclose(fp);
  return 0;
}
