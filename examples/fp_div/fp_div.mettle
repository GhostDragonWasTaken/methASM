import "std/io";
import "std/bench";

const N = 20000000;

fn div_chain() -> float64 {
  var acc: float64 = 1000000.0;
  var i: int32 = 1;
  while (i <= N) {
    var d: float64 = (float64)(i & 255) + 1.5;
    acc = acc / d + 1.0000001;
    i = i + 1;
  }
  return acc;
}

fn main() -> int32 {
  var passes: int32 = 20;
  println("float64 serial divide chain, 20M iters x 20 passes");

  var t0: int64 = bench_time_us();
  var acc: float64 = 0.0;
  var p: int32 = 0;
  while (p < passes) {
    acc = acc + div_chain();
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Checksum = ");
  println("{(int64)(acc * 1000.0)}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");
  return 0;
}
