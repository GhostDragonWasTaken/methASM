import "std/io";
import "std/bench";

fn sum_squares(n: int64) -> int64 {
  var sum: int64 = 0;
  var i: int64 = 1;
  while (i <= n) {
    sum = sum + i * i;
    i = i + 1;
  }
  return sum;
}

fn main() -> int32 {
  println("Sum of squares: 1²+2²+...+100000²");

  var result: int64 = sum_squares(100000);
  print("Sum = ");
  println("{result}");

  var passes: int32 = 200;
  println("Benchmark: 200 passes (sum_squares 100000 each)");

  var t0: int64 = bench_time_us();
  var p: int32 = 0;
  var bench_sum: int64 = 0;
  while (p < passes) {
    bench_sum = bench_sum + sum_squares(100000);
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum = ");
  println("{bench_sum}");

  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  var per_pass: int64 = elapsed_us / passes;
  print("Per pass: ~");
  print("{per_pass}");
  println(" us");

  return 0;
}
