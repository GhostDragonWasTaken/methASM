import "std/io";
import "std/mem";

var rng_state: int64 = 1;

fn next_byte() -> int32 {
  rng_state = (rng_state * 1103515245 + 12345) & 2147483647;
  return (int32)((rng_state >> 16) & 255);
}

fn qdot(a: int8*, b: int8*, n: int64) -> int32 {
  var sum: int32 = 0;
  var i: int64 = 0;
  while (i < n) {
    sum = sum + (int32)a[i] * (int32)b[i];
    i = i + 1;
  }
  return sum;
}

fn bsum(a: int8*, n: int64) -> int32 {
  var sum: int32 = 0;
  var i: int64 = 0;
  while (i < n) {
    sum = sum + (int32)a[i];
    i = i + 1;
  }
  return sum;
}

fn linear(inp: int8*, in_n: int64, w: int8*, bias: int32*, out_n: int64,
                out: int32*) {
  var asum: int32 = bsum(inp, in_n);
  var corr_a: int32 = 128 * asum;
  var zp_const: int32 = 16384 * (int32)in_n;
  var j: int64 = 0;
  while (j < out_n) {
    var wrow: int8* = &w[j * in_n];
    var raw: int32 = qdot(inp, wrow, in_n);
    var wsum: int32 = bsum(wrow, in_n);
    out[j] = raw - 128 * wsum - corr_a + zp_const + bias[j];
    j = j + 1;
  }
}

fn requantize_relu(logits: int32*, n: int64, shift: int32, out_q: int8*) {
  var i: int64 = 0;
  while (i < n) {
    var v: int32 = logits[i];
    if (v < 0) { v = 0; }
    v = v >> shift;
    if (v > 127) { v = 127; }
    out_q[i] = (int8)(v + 128);
    i = i + 1;
  }
}

fn argmax(logits: int32*, n: int64) -> int32 {
  var best: int32 = 0;
  var bestv: int32 = logits[0];
  var i: int64 = 1;
  while (i < n) {
    if (logits[i] > bestv) {
      bestv = logits[i];
      best = (int32)i;
    }
    i = i + 1;
  }
  return best;
}

fn main() -> int32 {
  var IN: int64 = 16;
  var H: int64 = 8;
  var OUT: int64 = 4;

  var w1: int8* = malloc(H * IN);
  var b1: int32* = malloc(H * 4);
  var w2: int8* = malloc(OUT * H);
  var b2: int32* = malloc(OUT * 4);

  var i: int64 = 0;
  while (i < H * IN) { w1[i] = (int8)next_byte(); i = i + 1; }
  i = 0;
  while (i < H) { b1[i] = next_byte() - 128; i = i + 1; }
  i = 0;
  while (i < OUT * H) { w2[i] = (int8)next_byte(); i = i + 1; }
  i = 0;
  while (i < OUT) { b2[i] = next_byte() - 128; i = i + 1; }

  var x: int8* = malloc(IN);
  var h_logits: int32* = malloc(H * 4);
  var h_q: int8* = malloc(H);
  var out_logits: int32* = malloc(OUT * 4);

  println("minimal quantized MLP inference (16 -> 8 -> 4)");

  var sample: int32 = 0;
  while (sample < 4) {
    i = 0;
    while (i < IN) { x[i] = (int8)next_byte(); i = i + 1; }

    linear(x, IN, w1, b1, H, h_logits);
    requantize_relu(h_logits, H, 6, h_q);
    linear(h_q, H, w2, b2, OUT, out_logits);
    var cls: int32 = argmax(out_logits, OUT);

    print("sample ");
    print("{(int64)sample}");
    print(": logits [ ");
    var c: int64 = 0;
    while (c < OUT) {
      print("{(int64)out_logits[c]}");
      print(" ");
      c = c + 1;
    }
    print("] -> class ");
    println("{(int64)cls}");

    sample = sample + 1;
  }

  return 0;
}
