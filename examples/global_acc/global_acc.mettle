import "std/io";
import "std/bench";

const N = 100000000;

var g_a: int64 = 1;
var g_b: int64 = 2;
var g_c: int64 = 3;

fn run() {
  var i: int64 = 0;
  while (i < (int64)N) {
    g_a = g_a + i;
    g_b = g_b ^ (g_a >> 3);
    g_c = g_c + g_a - g_b;
    i = i + 1;
  }
}

fn main() -> int32 {
  var passes: int32 = 3;
  println("Global RMW hot loop, 100M iters x 3 passes");

  var t0: int64 = bench_time_us();
  var p: int32 = 0;
  while (p < passes) {
    g_a = 1; g_b = 2; g_c = 3;
    run();
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Checksum = ");
  println("{g_a ^ g_b ^ g_c}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");
  return 0;
}
