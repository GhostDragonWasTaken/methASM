import "std/io";
import "std/bench";

const N = 60000000;

fn mix(a: int64, b: int64) -> int64 {
  return (a * 1103515245 + 12345) ^ (b + (a >> 7));
}

fn run() -> int64 {
  var acc: int64 = 1;
  var i: int64 = 0;
  while (i < (int64)N) {
    acc = mix(acc, i);
    i = i + 1;
  }
  return acc;
}

fn main() -> int32 {
  var passes: int32 = 5;
  println("Direct leaf call, 60M iters x 5 passes");

  var t0: int64 = bench_time_us();
  var acc: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    acc = acc ^ run();
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Checksum = ");
  println("{acc}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");
  return 0;
}
