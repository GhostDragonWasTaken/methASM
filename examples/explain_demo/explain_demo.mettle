import "std/io";
import "std/mem";
import "std/bench";

fn array_sum(a: int32*, n: int64) -> int64 {
  var sum: int64 = 0;
  var i: int64 = 0;
  while (i < n) {
    sum = sum + (int64)a[i];
    i = i + 1;
  }
  return sum;
}

@noinline fn step(p: int64, n: int64) -> int64 {
  var s: int64 = 0;
  var i: int64 = 0;
  while (i < n) {
    s = s + p * p;
    if ((i & 1) == 1) {
      s = s + p * p + i;
    }
    i = i + 1;
  }
  return s;
}

@noinline fn bit_blend(x: int64, y: int64, z: int64) -> int64 {
  return ((x | y) ^ (x & y)) | (z & z);
}

@noinline fn shuffle(x: int64) -> int64 {
  return (x ^ (x << 7)) ^ (x << 7);
}

fn gcd(a: int64, b: int64) -> int64 {
  if (b == 0) {
    return a;
  }
  return gcd(b, a % b);
}

fn lo_byte(x: int64) -> int64 {
  return x & 255;
}

fn main() -> int32 {
  println("--explain showcase");

  var n: int64 = 4096;
  var a: int32* = malloc(n * 4);
  if (a == 0) {
    println("malloc failed");
    return 1;
  }
  var i: int64 = 0;
  while (i < n) {
    a[i] = (int32)((i * 2654435761) % 1009);
    i = i + 1;
  }

  var total: int64 = array_sum(a, n);
  var mixed: int64 = step(7, 1000);
  var blended: int64 = bit_blend(total, mixed, 0x9E3779B9);
  var shuffled: int64 = shuffle(blended);
  var divisor: int64 = gcd(blended, shuffled) + lo_byte(shuffled);

  print("array_sum  = "); println("{total}");
  print("step       = "); println("{mixed}");
  print("bit_blend  = "); println("{blended}");
  print("shuffle    = "); println("{shuffled}");
  print("gcd+lo     = "); println("{divisor}");

  var passes: int32 = 2000;
  var t0: int64 = bench_time_us();
  var bench_sum: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    bench_sum = bench_sum + shuffle(bit_blend(total, step(p, 64), bench_sum));
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Bench sum  = "); println("{bench_sum}");
  print("Time: "); print("{elapsed_us}"); println(" us");

  free(a);
  return 0;
}
