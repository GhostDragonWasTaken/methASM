import "std/io";
import "std/mem";
import "std/bench";

const N = 256;

fn transpose(a: int32*, b: int32*) {
  var i: int32 = 0;
  while (i < N) {
    var j: int32 = 0;
    while (j < N) {
      b[j * N + i] = a[i * N + j];
      j = j + 1;
    }
    i = i + 1;
  }
}

fn main() -> int32 {
  var a: int32* = malloc((int64)N * N * 4);
  var b: int32* = malloc((int64)N * N * 4);
  var k: int32 = 0;
  while (k < N * N) {
    a[k] = (int32)(k * 2654435761);
    k = k + 1;
  }

  var passes: int32 = 4000;
  println("256x256 int32 transpose x 4000 passes");

  var t0: int64 = bench_time_us();
  var acc: int64 = 0;
  var p: int32 = 0;
  while (p < passes) {
    transpose(a, b);
    acc = acc + b[(N - 1) * N + 1] + b[N + (N - 1)];
    p = p + 1;
  }
  var elapsed_us: int64 = bench_time_us() - t0;

  print("Checksum = ");
  println("{acc}");
  print("Time: ");
  print("{elapsed_us}");
  println(" us");

  free(a);
  free(b);
  return 0;
}
