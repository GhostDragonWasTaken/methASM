import "std/io";

struct Foo {
  v: int32;
}

struct Bar {
  v: int32;
}

fn cast_bar(x: Foo) -> Bar {
  var r: Bar;
  r.v = x.v;
  return r;
}

fn cast_foo(x: Bar) -> Foo {
  var r: Foo;
  r.v = x.v;
  return r;
}

fn main() -> int32 {
  var a: Foo;
  a.v = 1;

  var b: Bar;
  b.v = 2;

  var a_as_bar: Bar = cast_bar(a);
  var c: Bar;
  c.v = a_as_bar.v + b.v;

  var d: Foo = cast_foo(b);

  print("a (Foo) = ");
  print("{a.v}");
  println("");

  print("b (Bar) = ");
  print("{b.v}");
  println("");

  print("c = cast[Bar]a + b (Bar) = ");
  print("{c.v}");
  println("");

  print("d = cast b (Foo) = ");
  print("{d.v}");
  println("");

  return c.v - 3;
}
